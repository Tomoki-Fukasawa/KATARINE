<div class="friend_list">
  <div class="member_list_title">
    <div class="say_come">探しちゃお!</div>
  </div>
  <h3>友達募集一覧</h3>
  <div class="member_lists">
    <% @users.each do |user|%>
      <div class="member">
        <div class="user_image">
          <%= image_tag user.image.variant(resize: '100x100') ,class:"item-box-img" if user.image.attached?%>
        </div>
        <div class="friend_detail">
          <div class="member_name">
            <%= user.nickname %>
          </div>
          <div class="friend_show_link">
            <%= link_to "この人の詳しい情報はこちら", user_path(user)%>
          </div>
        </div>
      </div>
    <%end%>
  </div>
</div>