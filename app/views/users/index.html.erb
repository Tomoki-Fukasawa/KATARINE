<div class="wrapper">
  <div class="left">
    <%= render "boards/board_list", boards: @boards %>
  </div>

  <div class="center">
    <%= render "users/friend_list", users: @users %> 
  </div>

  <div class="right">
    <% if user_signed_in?%>
      <%= render "items/item_list", items: @items %>
    <% end %>
  </div>
</div>
