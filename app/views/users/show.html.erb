<div class="contents row">
  <div class="user_image">
    <%= image_tag @user.image.variant(resize: '1000x100'),class:"item-box-img" %>
  </div>

  <% if user_signed_in? && current_user.id == @user.id %>
    <%= link_to 'マイページ編集', edit_user_registration_path(@user.id) %>
  <% end %>
  
  <p><%= @user.nickname %>さんの情報</p>
  <p><%= @user.birth_day %>さんの情報</p>
  <p>あいさつ文</p>
  <%= @user.greet %>
  <p>自己紹介</p>
  <%= @user.introduction %>

  <p>最近の投稿 投稿数 </p>
  <p>友達数</p>
  <p>誕生日：<%= @user.birth_day %></p>

  <% if user_signed_in?%>
    <% if current_user ==@user %>
      <%= button_to(
        current_user.friend_want? ? "友達募集を停止する" : "友達を募集する",
        friend_want_user_path(current_user),
        method: :patch
      )%>

      <%= link_to "友達関係についての情報はここから", friends_user_path(current_user), method: :get %>
    <% elsif current_user.friends_with?(@user)%>
    <%# # 友達登録済み %>
      <%# <%= link_to "友達関係を解消しますか？", friendship_path(@friendship),method: :delete %> %>
      <%= button_to "友達関係を解消しますか？", reject_friendship_path(@friendship), method: :patch  %>
    <% elsif current_user.pending_sent_to?(@user)%>
      <%# # 自分が友達登録申請中 %>
      <p>申請中です。お待ちください</p>
    <% elsif current_user.pending_received_from?(@user)%>
      <%# # 相手から申請中 %>
      <p>承認しますか？</p>
      <%= link_to "友達関係を承認します", friendship_path(@friendship), method: :patch %>
    <% else%>
      <%= button_to "友達申請をする",
        friendships_path(friend_id: @user.id),
        method: :post
      %>
    <%end %>   

  <% end %>

  <% if current_user == @user %>
    <h2>物品譲渡申請中一覧</h2>
    <p>出品した物品一覧</p>
    <% @items.each do |item| %>
      <div class="items">
        <p>作成者：<%= item.user.nickname %></p>
        <p><%= item.item_name %></p>
        <p>状態: <%= item.status_reservation_japanese %></p>
        <%= link_to "この物品の情報はこちら",item_path(item)%>
      </div>
    <% end %>

    <p>申請中の物品一覧</p>
    <% @item_requests.each do |request| %>
      <div class="requests">
        <p>作成者：<%= request.item.user.nickname %></p>
        <p><%= request.item.item_name %></p>
        <p>状態: <%= request.status_transfer_japanese %></p>
        <%= link_to "この物品の情報はこちら",item_path(request.item)%>
      </div>
    <% end %>
  <% end %>
  
  
</div>

