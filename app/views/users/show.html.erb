<%= render "shared/header" %>
<div class="user_show_contents">
  <div class="user_show_left">
    <div class="user_image">
      <%= image_tag @user.image.variant(resize: '1000x100'),class:"item-box-img" %>
    </div>

    <% if user_signed_in? && current_user.id == @user.id %>
      <%= link_to 'マイページ編集', edit_user_registration_path(@user.id) , class: "link_button"%>
    <% end %>
    
    <p><%= @user.nickname %>さんの情報</p>
    <p><%= @user.birth_day %>さんの情報</p>
    <p>あいさつ文</p>
    <%= @user.greet %>
    <p>自己紹介</p>
    <%= @user.introduction %>

    <p>誕生日：<%= @user.birth_day %></p>

    <% if user_signed_in?%>
      <% if current_user == @user %>
        <%= link_to(
          current_user.friend_want? ? "友達募集を停止する" : "友達を募集する",
          friend_want_user_path(current_user),
          data: {turbo_method: :patch}, class: "link_button"
        )%>
        <%= link_to "物品譲渡の記録はこちら", mypage_path, class: "link_button"%>
        <%= link_to "友達関係についての情報はここから", friends_user_path(current_user), data: {turbo_method: :get}, class: "link_button" %>
      <% elsif current_user.friends_with?(@user)%>
      <%# # 友達登録済み %>
        <%= link_to "友達関係を解消しますか？", friendship_path(@friendship), data: {turbo_method: :delete, turbo_confirm: "本当に友達関係を解消しますか"} , class: "link_button" %>
      <% elsif current_user.pending_sent_to?(@user)%>
        <%# # 自分が友達登録申請中 %>
        <p>申請中です。お待ちください</p>
      <% elsif current_user.pending_received_from?(@user)%>
        <%# # 相手から申請中 %>
        <p>承認しますか？</p>
        <%= link_to "友達関係を承認します", friendship_path(@friendship), data:{turbo_method: :patch},class: "link_button" %>
      <% else%>
        <%= link_to "友達申請をする",
          friendships_path(friend_id: @user.id),
          data: {turbo_method: :post},
          class: "link_button"
        %>
      <%end %>   
    <% end %>
  </div>
  <div class="user_show_right">
    <%= render "chat_rooms/chatroom_list", chat_rooms: @chat_rooms%>
  </div>
  
</div>

