<div class="contents row">
  <div class="user_image">
    <%= image_tag @user.image.variant(resize: '1000x100') ,class:"item-box-img" %>
  </div>

  <% if user_signed_in? && current_user.id == @user.id %>
    <%= link_to 'マイページ編集', edit_user_registration_path(@user.id) %>
  <% end %>
  
  <p><%= @user.nickname %>さんの情報</p>
  <p><%= @user.birth_day %>さんの情報</p>
  <p>あいさつ文</p>
  <%= @user.greet %>
  <p>自己紹介</p>
  <%= @user.introduction %>

  <p>最近の投稿 投稿数 </p>
  <p>友達数</p>

  <% if user_signed_in?%>
    <% if current_user ==@user %>
      <%= button_to(
        current_user.friend_want? ? "友達募集を停止する" : "友達を募集する",
        friend_want_user_path(@user),
        method: :patch
      )%>
    <% elsif @user == current_user.friend%>
    # 友達登録済み
    <% elsif current_user.friendship(state: pending) exist%>
    # 自分が友達登録申請中
    <% elsif @user.friendship(state: pending) exist%>
    # 相手から申請中
    <% else%>
      <%= button_to(
        current_user.friendship.create
        friendships_path(@user),
        method: :post
      )%>

    <%end %>   
  <% end %>



</div>

