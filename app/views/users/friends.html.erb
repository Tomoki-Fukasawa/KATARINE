<h1><%= @user.nickname %>の友達一覧</h1>
<% @friends.each do |friend| %>
  <div id="friend_permitted_users">
    <p>仲良くしましょう</p>
    <%= link_to friend.nickname, user_path(friend) %>
  </div>
<% end %>

<% if @user==current_user %>
  <h2><%= current_user.nickname %>の友達申請中一覧</h2>
  <div id="pending_sent">
    <% @pending_sent.each do |sent_user| %>
      
        <%= sent_user.friend.nickname%>
        <p>申請中です。お待ちください</p>
    <% end %>
  </div>

  <h3><%= current_user.nickname %>の友達承認待ち一覧</h3>
  <div id="pending_sent">
    <% @pending_received.each do |give_user| %>
      
        <%= give_user.user.nickname%>
        <%# <%= link_to "この人と友達になりますか？", friendship_path(give_user.user), method: :put  %> %>
        <%= button_to "この人と友達になりますか？", friendship_path(give_user), method: :put  %>
        <%= button_to "この人を拒否しますか？", reject_friendship_path( give_user), method: :patch  %>
    <% end %>
  </div>
  <h4><%= current_user.nickname %>の友達拒否一覧</h4>
  <div id="rejected_users">
    <% @rejected_user.each do |reject_user| %>
        <%= reject_user.user.nickname%>
        <%# <%= link_to "この人と友達になりますか？", friendship_path(give_user.user), method: :put  %> %>
        <%# <%= button_to "この人と友達になりますか？", friendship_path(friend_id: give_user.user), method: :put  %>
        <%# <%= button_to "この人を拒否しますか？", reject_friendship_path(friend_id: give_user.user), method: :patch  %> %> %>
    <% end %>
  </div>
<% end %>

