<h1><%= @user.nickname %>の友達一覧</h1>
<% @friends.each do |friend| %>
  <div>
    <p>仲良くしましょう</p>
    <%= link_to friend.nickname, user_path(friend) %>
  </div>
<% end %>

<h2><%= @user.nickname %>の友達申請中一覧</h2>
<% @users.each do |user| %>
  <div>
    <%= user.nickname%>
    <p>申請中です。お待ちください</p>
  </div>
<% end %>

<h3><%= @user.nickname %>の友達承認待ち一覧</h3>
<% @users.each do |user| %>
  <div>
    <%= user.nickname%>
    <p>承認しますか？</p>
    <%= link_to user.nickname, user_path(friend) %>
  </div>
<% end %>
