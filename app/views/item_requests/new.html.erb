<%= render "shared/second-header"%>
<h2>受け取り申請確認</h2>

<div class='transaction-contents'>
  <%= form_with model:@item,@item_request, url: item_requests_path, id: 'charge-form', class: 'transaction-form-wrap',local: true do |f| %>
  <%= render 'shared/error_messages', model: f.object %>
    <%=@item.item_name %>
    <%=@item.user.nickname%>

    <%= f.submit "上記の内容で受け取りを希望します",class:"buy-red-btn", id:"button"%>

  <% end %>
</div>
<%= render "shared/second-footer"%>