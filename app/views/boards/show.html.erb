<%= render "shared/header" %>

<div class="board_contents">
  <div class="board_head">
    <div class="board_title_show">
      <%= @board.title %>
    </div>
    <div class="board_date_show">
      <%= l @board.created_at, format: :long %>
    </div>
  </div>
  <div class="board_description">
    <%= @board.description %>
  </div>
  <div class="board_edit_or_delete">
    <ul class="more_list">
      <% if user_signed_in? && current_user.id == @board.user_id %>
        <li>
          <%= link_to '編集', edit_board_path(@board.id), method: :get, class: "board_ed_btn" %>
        </li>
        <div class="or">
          or
        </div>
        <li>
          <%= link_to '削除', board_path(@board), method: :delete , class: "board_ed_btn" %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<div class="container">
  <div class="comments">
    <h4><comment-list></h4>
    <% @comments.each do |comment|%>
      <p>
        <strong><%= link_to comment.user.nickname, "/users/#{comment.user_id}"%>:</strong>
        <%= comment.content %>
      </p>
    <% end%>
  </div>
  <div class="comments_form">
    <% if user_signed_in? %>
      <%= form_with(model: [@board,@comment], local:true) do |form|%>
        <%= form.label :content, 'コメント'%>
        <%=form.text_area :content, placeholder: "何話す？", rows:"10"%>
        <%=form.submit "SEND" %>
      <%end%>
    <% else %>
      <strong><p>※※※ コメントの投稿には新規登録/ログインが必要です ※※※</p></strong>
    <% end %>
  </div>
</div>