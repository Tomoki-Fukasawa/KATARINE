<div class="board_lists">
  <div class="make_boards">
    <div class="say_come">話しちゃお!</div>
    <% if user_signed_in? %>
          <%= link_to '掲示板・ブログを立てる', new_board_path %>
    <% end %>
  </div>
  <% @boards.each do |board| %>
    <div class="board_list">
      <div class="board_title">
        <%= board.title %>
      </div>
      <div class="board_detail">
        <div class="board_user">
          <%= board.user.nickname %>
        </div>
        <div class="board_date">
          <%= l board.created_at, format: :long %>
        </div>
      </div>
      <div class="board_link">
          <%= link_to 'この掲示板についてはこちら', board_path(board.id) %>
      </div>
    </div>
  <% end %>
</div>