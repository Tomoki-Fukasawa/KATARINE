<%= render "shared/header" %>
<h2>物品譲渡申請中一覧</h2>
<p>出品した物品一覧</p>
<% @items.each do |item| %>
  <div class="items">
    <%= image_tag item.image.variant(resize_to_limit:'200x200') ,class:"item-box-img" %>
    <p>作成者：<%= item.user.nickname %></p>
    <p><%= item.item_name %></p>
    <p>状態: <%= item.status_reservation_japanese %></p>
    <%= link_to "この物品の情報はこちら",item_path(item), class: "link_button"%>
  </div>
<% end %>

<p>申請中の物品一覧</p>
<% @item_requests.each do |request| %>
  <div class="requests">
    <%= image_tag request.item.image.variant(resize_to_limit:'200x200') ,class:"item-box-img" %>
    <p>作成者：<%= request.item.user.nickname %></p>
    <p><%= request.item.item_name %></p>
    <p>状態: <%= request.status_transfer_japanese %></p>
    <%= link_to "この物品の情報はこちら",item_path(request.item), class: "link_button"%>
  </div>
<% end %>
<p>物品新規出品</p>
<%= link_to "物品出品はこちらから", new_item_path, class: "link_button"%>
