<%= render "shared/header" %>

<div class="item-show">
  <div class="item-box">
    <h2 class="name">
      <%= @item.item_name %>
    </h2>
    <div class="item-img-content">
      <%= image_tag @item.image.variant(resize: '300x300') ,class:"item-box-img" %>
      <%if @item.item_requests.where(transfer: :accepted).exists? or @item.item_requests.where(transfer: :completed).exists?%>
      
        <div class="sold-out">
          <span>なくなりました。申し訳ありません!!</span>
        </div>
      <%end%>
    </div>

    <%if user_signed_in? && @item.available? %>
      <% if current_user.id ==@item.user_id %>
        <%= link_to "物品の編集", edit_item_path(@item), method: :get, class: "item-red-btn" %>
        <p class="or-text">or</p>
        <%= link_to "削除", item_path(@item), data: {turbo_method: :delete}, class:"item-destroy" %>
      <% else%>
        <%= link_to "受け取り申請画面に進む", item_item_requests_path(@item) ,data:{turbo: false},class:"item-red-btn"%>
      <% end %>
    <% end%>

    <div class="item-explain-box">
      <span><%= @item.item_script %></span>
    </div>
    <table class="detail-table">
      <tbody>
        <tr>
          <th class="detail-item">出品者</th>
          <td class="detail-value"><%= @item.user.nickname %></td>
        </tr>
        <tr>
          <th class="detail-item">カテゴリー</th>
          <td class="detail-value"><%= Category.find(@item.category_id).name %></td>
        </tr>
        <tr>
          <th class="detail-item">商品の状態</th>
          <td class="detail-value"><%= ItemState.find(@item.item_state_id).name %></td>
        </tr>
          <th class="detail-item">発送元の地域</th>
          <td class="detail-value"><%= Prefecture.find(@item.prefecture_id).name %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="lists">
    <ul class='item_requests-lists'>
      <% if current_user == @item.user%>
        <% @item_requests.each do |request|%>
          <li>
            <div class='sender-img-content'>
                <%= image_tag request.sender.image.variant(resize: '100x100'), class: "item-img" if request.sender.image.attached? %>
                <%= request.sender.nickname%>
            </div>
            <% if request.waiting?%>
              <h5>この人に物品を渡しますか？</h5>
              <%= link_to "渡したい場合はこちらをクリック", accept_item_item_request(item)%>
            <% elsif request.accepted?%>
              <h4>この人に物品を渡すことが確定しました。チャットで受け渡す日にちや場所を決めてください。</h4>
            <% elsif request.completed?%>
              <p>譲渡完了</p>
            <% elsif request.rejected?%>
              <p>却下済み</p>
            <% end %>
          </li>
          <% if request.count==0 %>
              <div class='item-info'>
                <h6 class='item-name'>
                  まだ相手は見つかっていません
                </h6>
              </div>
          <%end%>
        <% end %>
      <% else %>
        <% request = @item_requests.find_by(sender: current_user)%>
          <% if request.present?%>

            <%if request.completed? %>
              <div class='sold-out'>
                <p>譲渡完了!!</p>
              </div>
            <%elsif request.accepted?%>
              <div class='sold-out'>
                <p>受け取りましたか？</p>
                <%=link_to "受け取ったら、こちらをクリック",complete_item_item_request(request,@item)%>
              </div>
            <% elsif request.waiting?%>
              <div class='sold-out'>
                <p>返答を待っています</p>
              </div>
            <% elsif request.rejected?%>
              <p>今回は見送られました</p>
            <%end%>
          <%else%>
            <%= link_to "受け取り申請画面に進む", item_item_requests_path(@item) ,data:{turbo: false},class:"item-red-btn"%>
          <%end%>
      <% end %>
      
    </ul>
  </div>

</div>

<%= render "shared/footer" %>
