<div class="chat_rooms_list">
  <div class="rooms_list_title">
    <div class="say_come">何話す？</div>
  </div>
  <div class="member_lists">
    <% if user_signed_in? %>
      <% if current_user ==@user %>
        <% chat_rooms.each do |chatroom|%>
          <div class="chat_room">
            <div class="chatroom_head">
              <div class="user_image">
                <%= image_tag chatroom.partner(current_user).image.variant(resize_to_limit: [100, 100]) ,class:"item-box-img" if chatroom.partner(current_user).image.attached?%>
              </div>
              <div class="room_name">
                <%= chatroom.partner(current_user).nickname %>
              </div>
            </div>
            <div class="room_show_link">
              <%= link_to "この人と会話する", chat_room_path(chatroom), class: "link_button"%>
            </div>
          </div>
        <% end %>
      <% else %>
        <% if @chat_room_with_user.present? %>
          <%= link_to "この人と会話する", chat_room_path(@chat_room_with_user), class: "link_button" if @chat_room_with_user.present?  %>
        <% else %>
         <p>まだチャットルームはありません</p>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>